{
  "name": "Theme Ovi",
  "version": "1.0.5",
  "author": "Emidio Reggiani",
  "homepage": "https://emidio.reggiani.link/post/ovi-htmly-theme",
  "description": "A modern and sleek theme for blogs, derived from Occasio, with flavors and local comment system integration",
  "settings": [
    {
      "type": "select",
      "name": "flavor",
      "label": "Flavor Style",
      "value": "",
      "options": ["aqua", "coffee", "eggplant", "orange", "tea"],
      "info": "Choose theme flavor"
    },
    {
      "type": "checkbox",
      "name": "recent_posts",
      "label": "Recent Posts",
      "value": "",
      "info": "Enable Recent Posts widget"
    },
    {
      "type": "checkbox",
      "name": "popular_posts",
      "label": "Popular Posts",
      "value": "",
      "info": "Enable Popular Posts widget. The views counter needs to be enabled first."
    },
    {
      "type": "checkbox",
      "name": "recent_comments",
      "label": "Recent Comments",
      "value": "",
      "info": "Enable Recent Comments widget. Disqus or local comment system needs to be enabled first."
    },
    {
      "type": "checkbox",
      "name": "category_list",
      "label": "Category List",
      "value": "",
      "info": "Enable Category List widget"
    },
    {
      "type": "checkbox",
      "name": "tag_cloud",
      "label": "TagCloud",
      "value": "",
      "info": "Enable TagCloud widget"
    },
    {
      "type": "checkbox",
      "name": "archive_list",
      "label": "Archive",
      "value": "",
      "info": "Enable Archive widget"
    },
    {
      "type": "checkbox",
      "name": "webcam",
      "label": "Webcam",
      "value": "",
      "info": "Enable Webcam widget (change webcam.php accordingly)"
    }
  ]
}